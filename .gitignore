# Environment variables (do not commit secrets)
.env
.env.*
!.env.example
!**/.env.example

# Optional local native/third_party bundles under backend utils (legacy or future tools)
backend/utils/third_party/

# Generated logo detector samples / outputs (keep dirs via .gitkeep)
backend/utils/logo-detector-features/samples/*
!backend/utils/logo-detector-features/samples/.gitkeep
backend/utils/logo-detector-features/output/*
!backend/utils/logo-detector-features/output/.gitkeep
!backend/utils/logo-detector-features/output/logos/
backend/utils/logo-detector-features/output/logos/*
!backend/utils/logo-detector-features/output/logos/.gitkeep

# Scheduler persistence (rebuilt at runtime)
backend/data/*.json
backend/data/channels/*.json

backend/.env*
*.env*