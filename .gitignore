# Environment variables (do not commit secrets)
.env
.env.*
!.env.example
!**/.env.example

# Node dependencies (npm install per package)
backend/node_modules/
frontend/node_modules/

# Optional local native/third_party bundles under backend utils (legacy or future tools)
backend/utils/third_party/
backend/utils/logo-detector/logo-detector
backend/utils/logo-detector/logo-detector-debug-*.jpg

# Channel logos uploaded from UI (images + per-channel settings JSON)
backend/data/channel-logos/
backend/data/channel-settings/

# Scheduler persistence (rebuilt at runtime)
backend/data/*.json
backend/data/channels/*.json

backend/.env*
*.env*