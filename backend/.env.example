# Insight API credentials (used for automatic authentication)
INSIGHT_API_USERNAME=your_username_here
INSIGHT_API_PASSWORD=your_password_here

# Optional: same CDN often needs a browser User-Agent for HLS (vertical crop ffprobe + ffmpeg segment)
# VOD_FFMPEG_USER_AGENT=Mozilla/5.0 ...
# VOD_FFPROBE_USER_AGENT=Mozilla/5.0 ...

# Optional: whisper.cpp (subtitles). If unset, the backend uses whisper-cli on PATH, then /opt/whisper (Docker).
# WHISPER_CLI_PATH=/opt/whisper/whisper-cli
# WHISPER_MODEL_PATH=/opt/whisper/models/ggml-base.bin
# If whisper-cli is a dynamic build, set the directory that contains libwhisper.so (Docker sets this automatically):
# LD_LIBRARY_PATH=/opt/whisper/lib
# Optional: libass font name for burned subtitles (default DejaVu Sans)
# VOD_SUBTITLE_FONT_NAME=DejaVu Sans
